# Copie para `.env` e preencha com os dados do projeto Supabase
# (Lovable Cloud → aba Cloud/Backend, ou Supabase Dashboard → Project Settings → API).

SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_<sua-chave>"
SUPABASE_URL="https://<project-ref>.supabase.co"

# As variáveis VITE_* são embutidas no bundle do browser e por isso são públicas.
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<sua-chave>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"

# NUNCA coloque a service_role/secret key aqui. Ela só existe no servidor
# (SUPABASE_SERVICE_ROLE_KEY) e é injetada pelo Lovable Cloud em runtime.
